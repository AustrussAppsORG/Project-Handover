{
  // Serves index.html as a static asset; worker.js adds the R2 image
  // endpoints (/images/*, /api/images/*). No build step.
  "name": "austruss-handover",
  "main": "./worker.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/images/*"]
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "austruss-handover"
    }
  ],
  // Keep Worker logs in the Cloudflare dashboard (Workers > austruss-handover
  // > Logs) for troubleshooting.
  "observability": {
    "enabled": true
  }
}
